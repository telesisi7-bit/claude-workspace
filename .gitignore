# ============================================
#  .gitignore — GitHub에 "올리지 않을" 파일 목록
#  여기 적힌 파일은 git이 아예 못 본 척합니다.
#  주의: 설명(#)은 반드시 줄 맨 앞에! 규칙 뒤에 붙이면 규칙이 깨집니다.
# ============================================

# ── 비밀 정보: 절대 올리면 안 됨 ──
# .env 에는 API 키·Webhook 주소 같은 비밀번호급 정보가 들어갑니다.
.env
.env.*

# 단, 값이 빈 "견본" 파일은 공유해도 안전하므로 예외로 올립니다.
!.env.example

# 방명록(guestbook) — web/config.js 는 의도적으로 git에 포함시킵니다.
# Supabase "anon key"는 브라우저 코드 노출이 전제된 공개용 키이며
# (실제 보안은 RLS 정책이 담당), 정적 사이트(Vercel)가 이 값을
# 읽으려면 배포 파일에 포함돼야 하기 때문입니다.
# service_role 키 등 진짜 비밀 키는 여기 절대 넣지 않습니다.

# SSH·인증서 개인키
*.key
*.pem
id_rsa
id_rsa.*
credentials
credentials.*

# ── 내 PC 전용 설정 ──
# 다른 사람에겐 쓸모없고, 내부 폴더 경로가 노출됩니다.
.claude/settings.local.json
**/.claude/settings.local.json

# ── 백업·임시 파일 ──
*.bak
*.tmp
*~

# ── 실수로 생긴 빈 파일 ──
docx/re

# ── 윈도우/맥이 멋대로 만드는 파일 ──
Thumbs.db
desktop.ini
.DS_Store
